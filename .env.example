# Server only. Never upload a real .env or keys to Pages.
AI_ENABLED=false
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Select a currently available model in the creator's Google project.
GEMINI_MODEL=
# Milliseconds; 1000-20000. Tokens may include model reasoning.
AI_REQUEST_TIMEOUT=14000
AI_MAX_OUTPUT_TOKENS=600

# Optional OpenAI-compatible adapter (AI_PROVIDER=openai-compatible).
LUMO_API_BASE_URL=https://api.openai.com/v1/
LUMO_API_KEY=
LUMO_MODEL=
LUMO_TOKEN_FIELD=max_completion_tokens
LUMO_JSON_MODE=true

# Paid request budget per process; shared only for cost limiting.
LUMO_REQUESTS_PER_MINUTE=8
LUMO_REQUESTS_PER_DAY=120
LUMO_MAX_CONCURRENCY=4
LUMO_SESSION_REQUESTS_PER_MINUTE=4
LUMO_SESSION_REQUESTS_PER_DAY=40
LUMO_SESSION_TTL_SECONDS=7200
LUMO_MAX_SESSIONS=100
LUMO_PORT=8787
LUMO_BIND_HOST=127.0.0.1

# Production: exact HTTPS origins; TLS terminates at proxy.
# LUMO_BIND_HOST=0.0.0.0
# LUMO_PUBLIC_ORIGIN=https://your-backend.example
# LUMO_ALLOWED_ORIGINS=https://eduardochiapas.github.io
