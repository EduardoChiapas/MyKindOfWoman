# Copia como .env SOLAMENTE en tu equipo. Nunca lo publiques ni introduzcas la clave en la UI.
# Node 22+: node --env-file=.env server/lumo-server.cjs
LUMO_PORT=8787
LUMO_API_BASE_URL=https://api.openai.com/v1
LUMO_API_KEY=
# Modelo del proveedor con Chat Completions y modo JSON, elegido por el creador.
LUMO_MODEL=
LUMO_JSON_MODE=true
LUMO_TOKEN_FIELD=max_completion_tokens
LUMO_MAX_COMPLETION_TOKENS=220
LUMO_TIMEOUT_MS=11000
LUMO_REQUESTS_PER_MINUTE=8
LUMO_REQUESTS_PER_DAY=120
LUMO_MAX_CONCURRENCY=2
# Despliegue separado de GitHub Pages: orígenes exactos HTTPS, SIN ruta y sin *.
# Ejemplo: https://eduardochiapas.github.io (el repositorio /mi-juego NO es parte del origen).
LUMO_ALLOWED_ORIGINS=
# Origen HTTPS del propio backend, para validar Host tras el proxy del hosting.
LUMO_PUBLIC_ORIGIN=
# Local por defecto; usar 0.0.0.0 solo en hosting con LUMO_PUBLIC_ORIGIN y HTTPS del proxy.
LUMO_BIND_HOST=127.0.0.1
# Proveedores compatibles antiguos pueden necesitar LUMO_TOKEN_FIELD=max_tokens
# y LUMO_JSON_MODE=false. Sin clave/modelo la respuesta se etiqueta source=local.
# Los límites diarios son por proceso: al reiniciar se reinician. Usa también
# límites de gasto en el proveedor; esto no equivale a un presupuesto monetario.
